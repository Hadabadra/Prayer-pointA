{
  "id": "com.shiachrina.kivuntefila",
  "name": "כיוון תפילה",
  "version": "3.3.2",
  "description": "הכיוון לירושלים לפי מיקום, עיר או רחוב: חוגה, מצפן, מפות וכדור הארץ בלי אינטרנט, מצב טיסה, הלכות עם מקורות, וממשק באנגלית.",
  "author": "שיח רינה-עמודי שש",
  "schemaVersion": 1,
  "sdkVersion": "1.x",
  "stability": "beta",
  "minAppVersion": "0.9.98",
  "entrypoint": "index.html",
  "permissions": [
    "network.access",
    "network.localhost",
    "app.open_url",
    "calendar.read",
    "settings.read",
    "events.subscribe:calendar.city_changed",
    "plugin.open_other",
    "fs.user_files.read",
    "fs.user_files.write",
    "reader.open",
    "library.books.read",
    "notifications.system",
    "ui.create_shortcut",
    "reader.toolbar",
    "app.startup_contributions",
    "library.books.provide",
    "published_data.write"
  ],
  "network": {
    "enabled": true,
    "allowlist": [
      "127.0.0.1",
      "localhost",
      "https://get.geojs.io/v1/ip/geo.json",
      "https://nominatim.openstreetmap.org/reverse",
      "https://overpass-api.de/api/interpreter",
      "https://overpass.kumi.systems/api/interpreter",
      "https://achat-relay.e0548433917.workers.dev",
      "https://raw.githubusercontent.com/Hadabadra/Prayer-pointA/",
      "https://raw.githubusercontent.com/e0548433917-gif/otzaria/%D7%9B%D7%99%D7%95%D7%95%D7%9F-%D7%AA%D7%A4%D7%99%D7%9C%D7%94/kivun-tefila-data"
    ]
  },
  "contributes": {
    "toolTab": {
      "title": "כיוון תפילה",
      "order": 210,
      "defaultPinned": false,
      "iconName": "compass_northwest_24_regular"
    },
    "startup": {
      "toolbarItems": [
        {
          "id": "kivun-open",
          "title": "כיוון תפילה",
          "icon": "compass_northwest_24_regular",
          "contexts": [
            "reader-text"
          ],
          "openPlugin": true
        }
      ],
      "libraryBooks": [
        {
          "id": "parts",
          "provider": "kivun-tefila",
          "title": "כיוון תפילה",
          "icon": "compass_northwest_24_regular"
        }
      ]
    }
  },
  "homepage": "https://github.com/Hadabadra/Prayer-pointA/tree/%D7%9B%D7%99%D7%95%D7%95%D7%9F-%D7%AA%D7%A4%D7%99%D7%9C%D7%94",
  "icon": "icon.png"
}