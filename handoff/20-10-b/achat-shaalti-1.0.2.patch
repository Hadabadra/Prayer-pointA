diff --git a/bridge/PdfAssoc.cs b/bridge/PdfAssoc.cs
new file mode 100644
index 0000000..43b2d08
--- /dev/null
+++ b/bridge/PdfAssoc.cs
@@ -0,0 +1,214 @@
+using System.Diagnostics;
+using System.Runtime.InteropServices;
+using System.Text.Json;
+using Microsoft.Win32;
+
+namespace OtzariaBridge;
+
+/// <summary>שלב ד של docs/PDF-INTEGRATION-SPEC.md — "פתח באמצעות" של Windows ישירות לתוסף "צופה PDF+OCR".
+/// • רישום ב-HKCU (בלי הרשאות מנהל): Applications\OtzariaBridge.exe + ProgId OtzariaBridge.pdf ב-.pdf\OpenWithProgids,
+///   כך שהצופה מופיע ב"פתח באמצעות" וב"אפליקציות ברירת מחדל". נרשם אוטומטית בעליית הגשר (אפשר לבטל: pdf.assoc=false).
+/// • OtzariaBridge.exe --open-pdf "path" → הנתיב נכתב לתור (קובץ בתיקיית inbox, כדי לעבור בין מופעים בלי IPC),
+///   ואוצריא נפתחת ישירות בתוסף (otzaria://open/plugin/&lt;id&gt;). התוסף שולף ב-/pdf/inbox/list ומאשר ב-/pdf/inbox/ack.
+/// • חלון "פתח באמצעות" של Windows (בחירת תוכנה) נפתח מחוט STA עם חלון בעלים בחזית, כדי שלא ייעלם מאחור וייסגר מעצמו.</summary>
+internal static class PdfAssoc
+{
+    public const string PluginId = "com.chadbedera.pdfviewer";
+    private const string ProgId = "OtzariaBridge.pdf";
+    private const string ExeName = "OtzariaBridge.exe";
+    private static string InboxDir => Path.Combine(Config.Dir, "pdf-inbox");
+    private static readonly TimeSpan Ttl = TimeSpan.FromMinutes(10);
+
+    public static void Register()
+    {
+        Server.Route("/pdf/assoc/status", _ => Status());
+        Server.Route("/pdf/assoc/register", _ => { if (Kiosk.IsActive) throw BridgeException.Locked(); Write(); return Status(); });
+        Server.Route("/pdf/assoc/unregister", _ => { if (Kiosk.IsActive) throw BridgeException.Locked(); Remove(); Config.Set("pdf.assoc", false); return Status(); });
+        Server.Route("/pdf/assoc/open-settings", _ => { if (Kiosk.IsActive) throw BridgeException.Locked(); Process.Start(new ProcessStartInfo("ms-settings:defaultapps") { UseShellExecute = true }); return new { opened = true }; });
+        Server.Route("/pdf/inbox/list", _ => new { items = List() });
+        Server.Route("/pdf/inbox/ack", Ack);
+        // רישום אוטומטי בעלייה (מה שסוכם): הצופה מופיע ב"פתח באמצעות" בלי פעולה נוספת
+        try { if (Config.Get("pdf.assoc", true)) Write(); } catch (Exception ex) { Config.Log("pdf assoc: " + ex.Message); }
+    }
+
+    private static string Exe => Path.Combine(Path.GetDirectoryName(Environment.ProcessPath) ?? Config.Dir, ExeName);
+    private static string Command => "\"" + Exe + "\" --open-pdf \"%1\"";
+
+    private static object Status()
+    {
+        string cmd = null;
+        try { using var k = Registry.CurrentUser.OpenSubKey(@"Software\Classes\" + ProgId + @"\shell\open\command"); cmd = k?.GetValue("") as string; } catch { }
+        bool isDefault = false;
+        try
+        {
+            using var u = Registry.CurrentUser.OpenSubKey(@"Software\Microsoft\Windows\CurrentVersion\Explorer\FileExts\.pdf\UserChoice");
+            isDefault = string.Equals(u?.GetValue("ProgId") as string, ProgId, StringComparison.OrdinalIgnoreCase)
+                        || (u?.GetValue("ProgId") as string ?? "").Contains("OtzariaBridge", StringComparison.OrdinalIgnoreCase);
+        }
+        catch { }
+        return new { registered = cmd != null, isDefault, command = cmd };
+    }
+
+    private static void Write()
+    {
+        string name = Lang.T("צופה PDF+OCR (אוצריא)", "PDF+OCR Viewer (Otzaria)");
+        string icon = "\"" + Exe + "\",0";
+        var C = Registry.CurrentUser;
+        using (var k = C.CreateSubKey(@"Software\Classes\" + ProgId))
+        {
+            k.SetValue("", name); k.SetValue("FriendlyTypeName", name);
+            using (var di = k.CreateSubKey("DefaultIcon")) di.SetValue("", icon);
+            using (var sh = k.CreateSubKey(@"shell\open")) sh.SetValue("FriendlyAppName", name);
+            using (var c = k.CreateSubKey(@"shell\open\command")) c.SetValue("", Command);
+        }
+        using (var k = C.CreateSubKey(@"Software\Classes\Applications\" + ExeName))
+        {
+            k.SetValue("FriendlyAppName", name);
+            using (var st = k.CreateSubKey("SupportedTypes")) st.SetValue(".pdf", "");
+            using (var di = k.CreateSubKey("DefaultIcon")) di.SetValue("", icon);
+            using (var c = k.CreateSubKey(@"shell\open\command")) c.SetValue("", Command);
+        }
+        using (var k = C.CreateSubKey(@"Software\Classes\.pdf\OpenWithProgids")) k.SetValue(ProgId, Array.Empty<byte>(), RegistryValueKind.None);
+        // "אפליקציות ברירת מחדל" של Windows
+        using (var k = C.CreateSubKey(@"Software\OtzariaBridge\Capabilities"))
+        {
+            k.SetValue("ApplicationName", name); k.SetValue("ApplicationDescription", name);
+            using var fa = k.CreateSubKey("FileAssociations"); fa.SetValue(".pdf", ProgId);
+        }
+        using (var k = C.CreateSubKey(@"Software\RegisteredApplications")) k.SetValue("OtzariaBridge", @"Software\OtzariaBridge\Capabilities");
+        SHChangeNotify(0x08000000, 0, IntPtr.Zero, IntPtr.Zero); // SHCNE_ASSOCCHANGED
+    }
+
+    public static void Remove()
+    {
+        var C = Registry.CurrentUser;
+        try { C.DeleteSubKeyTree(@"Software\Classes\" + ProgId, false); } catch { }
+        try { C.DeleteSubKeyTree(@"Software\Classes\Applications\" + ExeName, false); } catch { }
+        try { using var k = C.OpenSubKey(@"Software\Classes\.pdf\OpenWithProgids", true); k?.DeleteValue(ProgId, false); } catch { }
+        try { C.DeleteSubKeyTree(@"Software\OtzariaBridge\Capabilities", false); } catch { }
+        try { using var k = C.OpenSubKey(@"Software\RegisteredApplications", true); k?.DeleteValue("OtzariaBridge", false); } catch { }
+        SHChangeNotify(0x08000000, 0, IntPtr.Zero, IntPtr.Zero);
+    }
+
+    [DllImport("shell32.dll")] private static extern void SHChangeNotify(int eventId, int flags, IntPtr a, IntPtr b);
+
+    // ── תור הפתיחה ─────────────────────────────────────────────────────────
+
+    /// <summary>OtzariaBridge.exe --open-pdf "path": נכתב לתור ופותח את אוצריא בתוסף. נקרא מ-Main לפני בדיקת המופע היחיד.</summary>
+    public static void Enqueue(string raw)
+    {
+        try
+        {
+            if (string.IsNullOrWhiteSpace(raw)) return;
+            string path = Path.GetFullPath(Environment.ExpandEnvironmentVariables(raw.Trim().Trim('"')));
+            if (!File.Exists(path)) return;
+            Directory.CreateDirectory(InboxDir);
+            string id = DateTime.UtcNow.ToString("yyyyMMddHHmmssfff") + "-" + Guid.NewGuid().ToString("N")[..8];
+            File.WriteAllText(Path.Combine(InboxDir, id + ".txt"), path);
+            OpenPluginInOtzaria();
+        }
+        catch (Exception ex) { Config.Log("open-pdf: " + ex.Message); }
+    }
+
+    private static void OpenPluginInOtzaria()
+    {
+        try { Process.Start(new ProcessStartInfo("otzaria://open/plugin/" + PluginId) { UseShellExecute = true }); return; }
+        catch (Exception ex) { Config.Log("open-pdf otzaria uri: " + ex.Message); }
+        try
+        {
+            string p = Config.Get<string>("kiosk.otzariaPath", "");
+            if (!string.IsNullOrEmpty(p) && File.Exists(p)) Process.Start(new ProcessStartInfo(p) { UseShellExecute = true });
+        }
+        catch { }
+    }
+
+    private static List<object> List()
+    {
+        var res = new List<object>();
+        if (!Directory.Exists(InboxDir)) return res;
+        foreach (var f in Directory.GetFiles(InboxDir, "*.txt").OrderBy(x => x, StringComparer.Ordinal))
+        {
+            try
+            {
+                var at = File.GetLastWriteTimeUtc(f);
+                if (DateTime.UtcNow - at > Ttl) { File.Delete(f); continue; }
+                string path = File.ReadAllText(f).Trim();
+                try { FxPolicy.EnsurePathAllowed(path); } catch { File.Delete(f); continue; } // מחוץ למדיניות — נזרק בשקט
+                if (Kiosk.IsActive && !Kiosk.AllowedExtensions.Any(x => x.Equals("pdf", StringComparison.OrdinalIgnoreCase))) continue;
+                long size = 0; try { size = new FileInfo(path).Length; } catch { }
+                res.Add(new { id = Path.GetFileNameWithoutExtension(f), path, name = Path.GetFileName(path), size, at = at.ToString("o"), source = "open-with" });
+            }
+            catch { }
+        }
+        return res;
+    }
+
+    private static object Ack(JsonElement b)
+    {
+        int n = 0;
+        if (b.ValueKind == JsonValueKind.Object && b.TryGetProperty("ids", out var ids) && ids.ValueKind == JsonValueKind.Array)
+            foreach (var e in ids.EnumerateArray())
+            {
+                string id = e.GetString() ?? "";
+                if (id.Length == 0 || id.IndexOfAny(Path.GetInvalidFileNameChars()) >= 0 || id.Contains("..")) continue;
+                string f = Path.Combine(InboxDir, id + ".txt");
+                try { if (File.Exists(f)) { File.Delete(f); n++; } } catch { }
+            }
+        return new { removed = n };
+    }
+
+    // ── חלון "פתח באמצעות" שנשאר פתוח ───────────────────────────────────
+
+    [StructLayout(LayoutKind.Sequential, CharSet = CharSet.Unicode)]
+    private struct OPENASINFO { public string pcszFile; public string pcszClass; public int oaifInFlags; }
+    [DllImport("shell32.dll", CharSet = CharSet.Unicode)] private static extern int SHOpenWithDialog(IntPtr hwnd, ref OPENASINFO info);
+    [DllImport("user32.dll")] private static extern IntPtr GetForegroundWindow();
+    [DllImport("user32.dll")] private static extern uint GetWindowThreadProcessId(IntPtr h, IntPtr pid);
+    [DllImport("user32.dll")] private static extern bool AttachThreadInput(uint a, uint b, bool attach);
+    [DllImport("user32.dll")] private static extern bool SetForegroundWindow(IntPtr h);
+    [DllImport("user32.dll")] private static extern bool AllowSetForegroundWindow(int pid);
+    [DllImport("kernel32.dll")] private static extern uint GetCurrentThreadId();
+
+    /// <summary>הקודם (rundll32 OpenAs_RunDLL מתהליך רקע) נפתח בלי זכות חזית, מאחורי אוצריא, ו"נעלם" אחרי כמה שניות
+    /// כי חלונית הבחירה של Windows 10/11 נסגרת כשאין לה פוקוס. כאן: חוט STA, חלון בעלים זעיר שנלקח לחזית,
+    /// ו-SHOpenWithDialog מודאלי עם OAIF_EXEC — נשאר עד שהמשתמש בוחר או סוגר.</summary>
+    public static void ShowOpenWith(string path)
+    {
+        var t = new Thread(() =>
+        {
+            try
+            {
+                using var owner = new Form
+                {
+                    FormBorderStyle = FormBorderStyle.None, ShowInTaskbar = false, TopMost = true,
+                    StartPosition = FormStartPosition.Manual, Size = new System.Drawing.Size(1, 1), Opacity = 0.01,
+                    Location = Cursor.Position,
+                };
+                owner.Show();
+                ForceForeground(owner.Handle);
+                var info = new OPENASINFO { pcszFile = path, pcszClass = null, oaifInFlags = 0x1 | 0x4 | 0x20 }; // ALLOW_REGISTRATION | EXEC | HIDE_REGISTRATION
+                int hr = SHOpenWithDialog(owner.Handle, ref info);
+                if (hr < 0 && hr != unchecked((int)0x800704C7)) // לא "בוטל ע"י המשתמש"
+                    Process.Start(new ProcessStartInfo("rundll32.exe", "shell32.dll,OpenAs_RunDLL " + path) { UseShellExecute = false });
+                owner.Close();
+            }
+            catch (Exception ex) { Config.Log("open-with dialog: " + ex.Message); }
+        }) { IsBackground = true, Name = "OpenWith" };
+        t.SetApartmentState(ApartmentState.STA);
+        t.Start();
+    }
+
+    private static void ForceForeground(IntPtr h)
+    {
+        try
+        {
+            AllowSetForegroundWindow(-1);
+            IntPtr fg = GetForegroundWindow();
+            uint fgT = fg == IntPtr.Zero ? 0 : GetWindowThreadProcessId(fg, IntPtr.Zero), me = GetCurrentThreadId();
+            if (fgT != 0 && fgT != me) AttachThreadInput(me, fgT, true);
+            SetForegroundWindow(h);
+            if (fgT != 0 && fgT != me) AttachThreadInput(me, fgT, false);
+        }
+        catch { }
+    }
+}
diff --git a/bridge/PdfOps.cs b/bridge/PdfOps.cs
new file mode 100644
index 0000000..c6f9942
--- /dev/null
+++ b/bridge/PdfOps.cs
@@ -0,0 +1,186 @@
+using System.Collections.Concurrent;
+using System.Diagnostics;
+using System.Text.Json;
+
+namespace OtzariaBridge;
+
+/// <summary>שלב ג של docs/PDF-INTEGRATION-SPEC.md — פעולות PDF כבדות במנוע מותקן (כמו ב-PDF24), עבור "צופה PDF+OCR".
+/// מנוע: Ghostscript — זה שמגיע עם PDF24 (Program Files\PDF24\gs\bin) או התקנה רגילה של Ghostscript; qpdf אם מותקן.
+/// הקובץ עובר בחתיכות (אין צורך בנתיב בדיסק ובמדיניות תיקיות): begin → chunk… → run → read… → end.
+///   POST /pdf/engines → { engines: [{ id, name, path }], ops: [...] }
+///   POST /pdf/op/begin {} → { id }
+///   POST /pdf/op/chunk { id, data (base64) } → { size }
+///   POST /pdf/op/run { id, op, params } → { size, engine }
+///   POST /pdf/op/read { id, offset } → { data (base64, עד 1MB), offset, size, done }
+///   POST /pdf/op/end { id } → { removed }
+/// פעולות: compress {level: screen|ebook|printer|prepress}, grayscale, pdfa, repair, protect {userPassword, ownerPassword},
+/// unlock {password}, linearize. קבצים זמניים ב-%TEMP%\OtzariaBridge-pdfops, נמחקים ב-end או אחרי שעה.</summary>
+internal static class PdfOps
+{
+    private static string Root => Path.Combine(Path.GetTempPath(), "OtzariaBridge-pdfops");
+    private static readonly ConcurrentDictionary<string, DateTime> Jobs = new();
+    private const long MaxBytes = 1024L * 1024 * 1024; // 1GB
+
+    public static void Register()
+    {
+        Server.Route("/pdf/engines", _ => Engines());
+        Server.Route("/pdf/op/begin", _ => Begin());
+        Server.Route("/pdf/op/chunk", Chunk);
+        Server.Route("/pdf/op/run", Run);
+        Server.Route("/pdf/op/read", Read);
+        Server.Route("/pdf/op/end", b => { Cleanup(Id(b)); return new { removed = true }; });
+        try { if (Directory.Exists(Root)) foreach (var d in Directory.GetDirectories(Root)) if (DateTime.UtcNow - Directory.GetLastWriteTimeUtc(d) > TimeSpan.FromHours(1)) Directory.Delete(d, true); } catch { }
+    }
+
+    // ── זיהוי מנועים ─────────────────────────────────────────────────────
+    private static string Gs()
+    {
+        string pf = Environment.GetFolderPath(Environment.SpecialFolder.ProgramFiles), pf86 = Environment.GetFolderPath(Environment.SpecialFolder.ProgramFilesX86),
+               la = Environment.GetFolderPath(Environment.SpecialFolder.LocalApplicationData);
+        var cands = new List<string>
+        {
+            Path.Combine(pf, "PDF24", "gs", "bin", "gswin64c.exe"), Path.Combine(pf, "PDF24", "gs", "bin", "gswin32c.exe"),
+            Path.Combine(pf86, "PDF24", "gs", "bin", "gswin32c.exe"), Path.Combine(la, "PDF24", "gs", "bin", "gswin64c.exe"),
+        };
+        foreach (var root in new[] { Path.Combine(pf, "gs"), Path.Combine(pf86, "gs") })
+            try { if (Directory.Exists(root)) foreach (var d in Directory.GetDirectories(root).OrderByDescending(x => x)) { cands.Add(Path.Combine(d, "bin", "gswin64c.exe")); cands.Add(Path.Combine(d, "bin", "gswin32c.exe")); } } catch { }
+        return cands.FirstOrDefault(File.Exists) ?? OnPath("gswin64c.exe") ?? OnPath("gswin32c.exe");
+    }
+
+    private static string Qpdf()
+    {
+        string pf = Environment.GetFolderPath(Environment.SpecialFolder.ProgramFiles);
+        try { foreach (var d in Directory.GetDirectories(pf, "qpdf*")) { var p = Path.Combine(d, "bin", "qpdf.exe"); if (File.Exists(p)) return p; } } catch { }
+        return OnPath("qpdf.exe");
+    }
+
+    private static string OnPath(string exe)
+    {
+        foreach (var dir in (Environment.GetEnvironmentVariable("PATH") ?? "").Split(';'))
+            try { var p = Path.Combine(dir.Trim().Trim('"'), exe); if (dir.Length > 0 && File.Exists(p)) return p; } catch { }
+        return null;
+    }
+
+    private static object Engines()
+    {
+        var list = new List<object>();
+        string gs = Gs(), q = Qpdf();
+        if (gs != null) list.Add(new { id = "ghostscript", name = gs.Contains("PDF24", StringComparison.OrdinalIgnoreCase) ? "Ghostscript (PDF24)" : "Ghostscript", path = gs });
+        if (q != null) list.Add(new { id = "qpdf", name = "qpdf", path = q });
+        var ops = new List<string>();
+        if (gs != null) ops.AddRange(new[] { "compress", "grayscale", "pdfa", "repair", "protect", "unlock" });
+        if (q != null) ops.AddRange(new[] { "linearize", "protect", "unlock", "repair" });
+        return new { engines = list, ops = ops.Distinct() };
+    }
+
+    // ── העברת קבצים ─────────────────────────────────────────────────────
+    private static string Id(JsonElement b)
+    {
+        string id = b.Req("id");
+        if (id.Length != 32 || !id.All(Uri.IsHexDigit)) throw BridgeException.BadRequest("מזהה לא תקין");
+        if (!Jobs.ContainsKey(id)) throw new BridgeException("not_found", "הפעולה לא נמצאה (פג תוקף?)", 404);
+        Jobs[id] = DateTime.UtcNow;
+        return id;
+    }
+    private static string Dir(string id) => Path.Combine(Root, id);
+
+    private static object Begin()
+    {
+        if (Kiosk.IsActive) throw BridgeException.Locked();
+        string id = Guid.NewGuid().ToString("N");
+        Directory.CreateDirectory(Dir(id));
+        Jobs[id] = DateTime.UtcNow;
+        return new { id };
+    }
+
+    private static object Chunk(JsonElement b)
+    {
+        string id = Id(b), f = Path.Combine(Dir(id), "in.pdf");
+        byte[] data = Convert.FromBase64String(b.Req("data"));
+        using (var s = new FileStream(f, FileMode.Append, FileAccess.Write)) { if (s.Length + data.Length > MaxBytes) throw BridgeException.BadRequest("הקובץ גדול מדי"); s.Write(data); }
+        return new { size = new FileInfo(f).Length };
+    }
+
+    private static object Read(JsonElement b)
+    {
+        string id = Id(b), f = Path.Combine(Dir(id), "out.pdf");
+        if (!File.Exists(f)) throw new BridgeException("not_found", "אין תוצאה", 404);
+        long off = b.Long("offset", 0), size = new FileInfo(f).Length;
+        using var s = File.OpenRead(f);
+        s.Seek(off, SeekOrigin.Begin);
+        var buf = new byte[(int)Math.Min(1024 * 1024, Math.Max(0, size - off))];
+        int n = s.Read(buf, 0, buf.Length);
+        return new { data = Convert.ToBase64String(buf, 0, n), offset = off + n, size, done = off + n >= size };
+    }
+
+    private static void Cleanup(string id) { try { Jobs.TryRemove(id, out _); Directory.Delete(Dir(id), true); } catch { } }
+
+    // ── הרצה ────────────────────────────────────────────────────────────
+    private static object Run(JsonElement b)
+    {
+        if (Kiosk.IsActive) throw BridgeException.Locked();
+        string id = Id(b), dir = Dir(id), inp = Path.Combine(dir, "in.pdf"), outp = Path.Combine(dir, "out.pdf");
+        if (!File.Exists(inp)) throw BridgeException.BadRequest("לא הועלה קובץ");
+        try { File.Delete(outp); } catch { }
+        string op = b.Req("op");
+        JsonElement p = b.TryGetProperty("params", out var pp) && pp.ValueKind == JsonValueKind.Object ? pp : default;
+        string P(string k, string def = "") => p.ValueKind == JsonValueKind.Object ? (p.Str(k, def) ?? def) : def;
+        string gs = Gs(), q = Qpdf();
+        var a = new List<string>();
+        string exe, engine;
+
+        bool useQpdf = q != null && (op == "linearize" || ((op == "protect" || op == "unlock" || op == "repair") && gs == null));
+        if (useQpdf)
+        {
+            exe = q; engine = "qpdf";
+            switch (op)
+            {
+                case "linearize": a.AddRange(new[] { "--linearize", inp, outp }); break;
+                case "repair": a.AddRange(new[] { inp, outp }); break;
+                case "unlock": a.Add("--password=" + P("password")); a.AddRange(new[] { "--decrypt", inp, outp }); break;
+                case "protect":
+                    string up = P("userPassword"), own = P("ownerPassword");
+                    if (own.Length == 0) own = up.Length > 0 ? up : Guid.NewGuid().ToString("N");
+                    a.AddRange(new[] { "--encrypt", up, own, "256", "--", inp, outp }); break;
+            }
+        }
+        else
+        {
+            if (gs == null) throw BridgeException.Unsupported("לא נמצא מנוע PDF: יש להתקין את PDF24 או Ghostscript");
+            exe = gs; engine = gs.Contains("PDF24", StringComparison.OrdinalIgnoreCase) ? "ghostscript-pdf24" : "ghostscript";
+            a.AddRange(new[] { "-dBATCH", "-dNOPAUSE", "-dQUIET", "-dSAFER", "-sDEVICE=pdfwrite", "-dCompatibilityLevel=1.7" });
+            switch (op)
+            {
+                case "compress":
+                    string lvl = P("level", "ebook");
+                    if (!new[] { "screen", "ebook", "printer", "prepress" }.Contains(lvl)) lvl = "ebook";
+                    a.Add("-dPDFSETTINGS=/" + lvl); a.Add("-dDetectDuplicateImages=true"); break;
+                case "grayscale": a.AddRange(new[] { "-sColorConversionStrategy=Gray", "-dProcessColorModel=/DeviceGray" }); break;
+                case "pdfa": a.AddRange(new[] { "-dPDFA=2", "-dPDFACompatibilityPolicy=1", "-sColorConversionStrategy=RGB" }); break;
+                case "repair": break;
+                case "unlock": a.Add("-sPDFPassword=" + P("password")); break;
+                case "protect":
+                    string up = P("userPassword"), own = P("ownerPassword");
+                    if (own.Length == 0) own = up.Length > 0 ? up : Guid.NewGuid().ToString("N");
+                    a.Add("-sOwnerPassword=" + own); if (up.Length > 0) a.Add("-sUserPassword=" + up); a.Add("-dEncryptionR=3"); a.Add("-dKeyLength=128"); break;
+                default: throw BridgeException.BadRequest("פעולה לא מוכרת: " + op);
+            }
+            a.Add("-sOutputFile=" + outp); a.Add(inp);
+        }
+        if (a.Count == 0) throw BridgeException.BadRequest("פעולה לא מוכרת: " + op);
+
+        var psi = new ProcessStartInfo(exe) { UseShellExecute = false, CreateNoWindow = true, RedirectStandardError = true, RedirectStandardOutput = true };
+        foreach (var x in a) psi.ArgumentList.Add(x);
+        using var pr = Process.Start(psi);
+        var err = pr.StandardError.ReadToEndAsync(); _ = pr.StandardOutput.ReadToEndAsync();
+        if (!pr.WaitForExit(10 * 60 * 1000)) { try { pr.Kill(true); } catch { } throw new BridgeException("timeout", "הפעולה ארכה יותר מדי", 504); }
+        // qpdf מחזיר 3 על אזהרות — התוצאה תקינה
+        if (!File.Exists(outp) || new FileInfo(outp).Length == 0 || (pr.ExitCode != 0 && !(engine == "qpdf" && pr.ExitCode == 3)))
+        {
+            string msg = (err.Result ?? "").Trim();
+            if (op == "unlock" && msg.Contains("password", StringComparison.OrdinalIgnoreCase)) throw new BridgeException("wrong_password", "סיסמה שגויה", 401);
+            throw new BridgeException("op_failed", "הפעולה נכשלה: " + (msg.Length > 300 ? msg[..300] : msg), 500);
+        }
+        return new { size = new FileInfo(outp).Length, inSize = new FileInfo(inp).Length, engine };
+    }
+}
